# Copy to .env and fill in. Never commit .env (it's gitignored).
# ChipIn reads ./.env at startup for any variable not already set in the real
# environment (real env vars win; empty values here are ignored).

# --- Both modes ---------------------------------------------------------------
# Selects the transport and storage: "local" (Socket Mode + a JSON data file) or
# "gcp" (HTTP webhooks + Firestore, for Cloud Run). Defaults to "local".
ENVIRONMENT=local

# Bot token, from OAuth & Permissions after installing the app (xoxb-...).
SLACK_BOT_TOKEN=

# Linear auth: set EITHER a personal API key OR both client_id/secret, never
# both (ChipIn refuses to start if it sees both). See README "Authenticate to
# Linear" for how to create each.
LINEAR_API_KEY=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=

# --- ENVIRONMENT=local (Socket Mode) ------------------------------------------
# App-level token with the connections:write scope (xapp-...), from
# Basic Information → App-Level Tokens.
SLACK_APP_TOKEN=
# Where local mode keeps its data (one JSON file, rewritten atomically on every
# save). Optional; defaults to ./chipin.json. Only one process may use a file.
# An old SQLite file here is refused with an error: delete it or pick a new path.
DB_PATH=./chipin.json

# --- ENVIRONMENT=gcp (Cloud Run) ----------------------------------------------
# Signing secret from Basic Information → App Credentials.
SLACK_SIGNING_SECRET=
# GCP project that hosts Firestore.
GCP_PROJECT_ID=
# Optional; defaults to (default). Keep it: Firestore's free quota only covers the
# (default) database, so a named one bills every read and write.
FIRESTORE_DATABASE_ID=(default)
# Optional; Cloud Run sets this automatically. Defaults to 8080.
PORT=8080

# --- Local development only ---------------------------------------------------
# Point the Firestore client at the local emulator (set by ./firestore.sh start).
# Leave unset to use real Firestore.
# FIRESTORE_EMULATOR_HOST=localhost:8219
